# Neon PostgreSQL Connection String
# Get this from your Neon console (e.g. https://console.neon.tech)
# Either standard postgresql:// URI format or ADO.NET key-value format is supported:
DATABASE_URL=postgresql://neondb_owner:YOUR_PASSWORD@ep-example-12345.us-east-2.aws.neon.tech/neondb?sslmode=require

# If DATABASE_URL is commented out or empty, CampFix will automatically fall back to local SQLite (campfix.db).
